{
  "name": "immosnap-v2",
  "version": "2.0.0",
  "description": "ImmoSnap v2 — clean-slate, telemetry-first, perf-first rebuild (photo of a TE KOOP sign -> matching real-estate listing)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "verify:gate": "tsx src/verify-gate.ts",
    "test": "node --import tsx --test src/lib/*.test.ts src/*.test.ts",
    "e2e": "tsx src/e2e.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "exifr": "^7.1.3",
    "hono": "^4.12.27",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "puppeteer-core": "^23.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}